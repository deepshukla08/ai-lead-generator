# Copy to .env and fill in. Never commit .env.
# `docker compose` reads this file automatically from the repo root.

# ---------- Core ----------
ENVIRONMENT=local
LOG_LEVEL=INFO

# ---------- Postgres (pgvector) ----------
POSTGRES_USER=agentsdr
POSTGRES_PASSWORD=agentsdr
POSTGRES_DB=agentsdr
POSTGRES_PORT=5432
# Used by the Python services (host `postgres` = the compose service name)
DATABASE_URL=postgresql+asyncpg://agentsdr:agentsdr@postgres:5432/agentsdr

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---------- Service ports (host side) ----------
API_PORT=8000
AI_SERVICE_PORT=8001
FRONTEND_PORT=3000
LANGFUSE_PORT=3001

# ---------- Internal service URLs ----------
AI_SERVICE_URL=http://ai-service:8001
API_URL=http://api:8000
# Browser -> API. Must be reachable from the host, not from inside Docker.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Langfuse (self-hosted observability) ----------
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Generate: openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=change-me-openssl-rand-hex-32
LANGFUSE_SALT=change-me-openssl-rand-hex-32
LANGFUSE_ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# ---------- LLM providers (pick one or more) ----------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ---------- Embeddings (local, free) ----------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---------- Storage ----------
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/storage

# ---------- Email ----------
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=
